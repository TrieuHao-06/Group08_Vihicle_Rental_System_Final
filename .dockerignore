# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git/
.gitignore

# Environment variables & secrets (Bảo mật: Tuyệt đối không đưa vào image)
.env
.env.*
!.env.example

# Local MySQL binary data & sockets (Tránh lỗi socket và không đưa dữ liệu máy host vào image)
database/
*.sock

# Temporary files & Logs
*.log
tmp/
temp/
venv/
__pycache__/
*.pyc

# IDE & Editor files
.vscode/
.idea/
.gemini/
scratch/

# Test scripts & temp files
test_*.js
check_*.js
